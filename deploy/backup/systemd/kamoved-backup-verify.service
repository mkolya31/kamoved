[Unit]
Description=Verify Kamoved backup by restoring it into an isolated PostgreSQL
Documentation=file:/opt/kamoved/deploy/backup/README.md
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
TimeoutStartSec=6h
User=root
Group=root
UMask=0077
EnvironmentFile=/etc/kamoved/backup.env
ExecStart=/usr/bin/bash /opt/kamoved/deploy/backup/kamoved-backup.sh verify
CacheDirectory=kamoved-restic
CacheDirectoryMode=0700
StateDirectory=kamoved-backup
StateDirectoryMode=0700
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/lock
NoNewPrivileges=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
