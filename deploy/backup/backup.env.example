# Timeweb S3 credentials. Find them on the bucket dashboard.
AWS_ACCESS_KEY_ID=replace-with-s3-access-key
AWS_SECRET_ACCESS_KEY=replace-with-s3-secret-key
AWS_DEFAULT_REGION=ru-1

# Use the path-style Timeweb endpoint followed by the bucket and repository path.
RESTIC_REPOSITORY=s3:https://s3.twcstorage.ru/replace-with-bucket-name/kamoved-restic
RESTIC_PASSWORD_FILE=/etc/kamoved/restic-password

# Kamoved production location on the VPS.
KAMOVED_COMPOSE_DIR=/opt/kamoved
KAMOVED_COMPOSE_FILE=compose.production.yaml
KAMOVED_ENV_FILE=.env.production

# Retention: 48 hourly, 30 daily, and 13 weekly snapshots.
BACKUP_KEEP_HOURLY=48
BACKUP_KEEP_DAILY=30
BACKUP_KEEP_WEEKLY=13
