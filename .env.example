POSTGRES_DB=kamoved
POSTGRES_USER=kamoved
POSTGRES_PASSWORD=change-me-db

KAMOVED_USERS_0_USERNAME=admin
KAMOVED_USERS_0_PASSWORD=change-me-local
KAMOVED_USERS_0_DISPLAY_NAME=Администратор
KAMOVED_USERS_0_EMAIL=admin@kamoved.local
KAMOVED_USERS_0_ACTIVE=true
KAMOVED_USERS_0_NOTIFICATIONS=

KAMOVED_USERS_1_USERNAME=test-user
KAMOVED_USERS_1_PASSWORD=password-for-test-user
KAMOVED_USERS_1_DISPLAY_NAME=Тестовый
KAMOVED_USERS_1_EMAIL=test-user@kamoved.local
KAMOVED_USERS_1_ACTIVE=true
KAMOVED_USERS_1_NOTIFICATIONS=

# Отправка уведомлений через Timeweb Cloud. В production задайте реальные
# значения в .env.production; пароль не храните в Git.
KAMOVED_MAIL_ENABLED=false
KAMOVED_MAIL_HOST=smtp.timeweb.ru
KAMOVED_MAIL_PORT=465
KAMOVED_MAIL_SSL_ENABLED=true
KAMOVED_MAIL_STARTTLS_ENABLED=false
KAMOVED_MAIL_USERNAME=info@kamoved.ru
KAMOVED_MAIL_PASSWORD=change-me-mail-password
KAMOVED_MAIL_FROM=info@kamoved.ru
KAMOVED_MAIL_FROM_NAME=Камовед
# Если значение задано, все письма уходят только на этот тестовый адрес.
# KAMOVED_MAIL_REDIRECT_TO=

# Дополнительный пользователь:
# KAMOVED_USERS_2_USERNAME=логин
# KAMOVED_USERS_2_PASSWORD=change-me-password
# KAMOVED_USERS_2_DISPLAY_NAME=Имя
